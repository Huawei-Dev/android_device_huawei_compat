# ==========================================
# hal_fm_default.te (FM Radio)
# ==========================================
type hal_fm_default, domain;
hal_server_domain(hal_fm_default, hal_fm)

type hal_fm_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_fm_default)

# HwBinder IPC from client to server
binder_call(hal_fm_client, hal_fm_server)
binder_call(hal_fm_server, hal_fm_client)
hal_attribute_hwservice(hal_fm, hal_fm_hwservice)

allow hal_fm_default hi110x_dev:chr_file { open read write };
allow hal_fm_default sysfs:file { read open getattr };
