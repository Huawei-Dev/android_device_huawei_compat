# ==========================================
# hal_gnss_default.te - Standard GPS
# ==========================================
allow hal_gnss_default hi110x_daemon:unix_stream_socket connectto;
allow hal_gnss_default hi110x_data_file:dir search;
allow hal_gnss_default hi110x_data_file:sock_file write;
allow hal_gnss_default sysfs:file { getattr open read };

allow hal_gnss_default proc_gps_type:dir { search };
