# ==========================================
# hal_graphics_composer_default.te - Display Composer
# ==========================================
# Allows composer to listen to uevents (e.g., screen hotplugs or vsync)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read setopt };

allow hal_graphics_composer_default sysfs:file { open read };
allow hal_graphics_composer_default vndbinder_device:chr_file { ioctl open read write };

allow hal_graphics_composer_default sysfs_devfreq:dir search;
allow hal_graphics_composer_default sysfs_devfreq:file { read open };
allow hal_graphics_composer_default device_latency:chr_file { read write open };
