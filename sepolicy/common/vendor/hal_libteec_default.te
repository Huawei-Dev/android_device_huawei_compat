# ==========================================
# hal_libteec_default.te (Huawei TEE Client)
# ==========================================
type hal_libteec_default, domain;
hal_server_domain(hal_libteec_default, hal_libteec)

type hal_libteec_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_libteec_default)

# HwBinder IPC from client to server
binder_call(hal_libteec_client, hal_libteec_server)
binder_call(hal_libteec_server, hal_libteec_client)
hal_attribute_hwservice(hal_libteec, hal_libteec_hwservice)
