type vendor_nfc_setup, domain;
type vendor_nfc_setup_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_nfc_setup)

type vendor_hw_nfc_prop, property_type, vendor_property_type;

set_prop(vendor_nfc_setup, vendor_hw_nfc_prop)

allow vendor_nfc_setup proc:file r_file_perms;
allow vendor_nfc_setup vendor_file:dir search;
allow vendor_nfc_setup vendor_configs_file:dir search;
allow vendor_nfc_setup vendor_configs_file:file r_file_perms;

allow vendor_nfc_setup vendor_file:file { create open getattr setattr read write };
allow vendor_nfc_setup vendor_file:dir { search write add_name };

allow vendor_nfc_setup self:capability sys_admin;
allow vendor_nfc_setup self:filesystem mount;

allow vendor_nfc_setup vendor_file:file mounton;
