###########################################
# POWER & THERMAL (Battery, Charging, GPU)
###########################################

# GPU Frequency and Power Policies (Mali GPU)
genfscon sysfs /devices/platform/e82c0000.mali/power_policy                u:object_r:sysfs_pg:s0
genfscon sysfs /devices/platform/e82c0000.mali/devfreq/gpufreq/max_freq    u:object_r:sysfs_pg:s0
genfscon sysfs /devices/platform/e82c0000.mali/devfreq/gpufreq/min_freq    u:object_r:sysfs_pg:s0
genfscon sysfs /devices/platform/e82c0000.mali/devfreq/gpufreq/cur_freq    u:object_r:sysfs_pg:s0
genfscon sysfs /devices/platform/e8970000.mali/devfreq/gpufreq/max_freq    u:object_r:sysfs_pg:s0

# Battery and Fuel Gauge (Coulomb Counter)
genfscon sysfs /devices/platform/balong_power/state                        u:object_r:modem_state_file:s0
genfscon sysfs /devices/platform/battery/power_supply/Battery/capacity     u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/coul_core                                 u:object_r:sysfs_power:s0
genfscon sysfs /devices/virtual/ina231/ina231_0/ina231_value               u:object_r:sysfs_framebuffer:s0
genfscon sysfs /devices/virtual/ina231/ina231_1/ina231_value               u:object_r:sysfs_framebuffer:s0

# Thermal / Guard Monitoring
genfscon sysfs /bus/platform/drivers/huawei,camcfgdev/guard_thermal        u:object_r:sysfs_pg:s0

genfscon sysfs /devices/platform/fffc0000.ddr_devfreq/devfreq/ddrfreq      u:object_r:sysfs_devfreq:s0
genfscon sysfs /devices/virtual/thermal                                    u:object_r:sysfs_thermal:s0
genfscon sysfs /devices/platform/huawei_touch                              u:object_r:sysfs_touchscreen:s0

###########################################
# DISPLAY & GRAPHICS (LCD Panel)
###########################################

# LCD Modes (Color temperature, Voltage, Effect Engines)
genfscon sysfs /devices/virtual/graphics/fb0/lcd_support_mode              u:object_r:sysfs_pg:s0
genfscon sysfs /devices/virtual/graphics/fb0/lcd_comform_mode              u:object_r:sysfs_pg:s0
genfscon sysfs /devices/virtual/graphics/fb0/effect_available              u:object_r:sysfs_pg:s0
genfscon sysfs /devices/virtual/graphics/fb0/lcd_voltage_enable            u:object_r:sysfs_pg:s0
genfscon sysfs /devices/virtual/graphics/fb0/lcd_color_temperature         u:object_r:sysfs_pg:s0
genfscon sysfs /devices/virtual/graphics/fb0/led_rg_lcd_color_temperature  u:object_r:sysfs_pg:s0

###########################################
# CORE KERNEL & SCHEDULER
###########################################

# Energy Aware Scheduling (EAS) and Watchdogs
genfscon sysfs /kernel/eas/boost                                           u:object_r:sysfs_eas:s0
genfscon sysfs /kernel/init_watchdog                                       u:object_r:sysfs_init_watchdog:s0

# CPU Governor & Frequency (Generic)
genfscon sysfs /devices/system/cpu/cpufreq/policy0                         u:object_r:sysfs_cpufreq:s0
genfscon sysfs /devices/system/cpu/cpufreq/policy4                         u:object_r:sysfs_cpufreq:s0

###########################################
# SENSORS & SPECIAL HARDWARE
###########################################

# HiSEE (Huawei Secure Element / Integrated SIM)
genfscon sysfs /devices/platform/0.hisee                                   u:object_r:sysfs_hisee:s0

# SensorHub Debugging and Dumps
genfscon sysfs /class/sensors/sensorhub_dbg                                u:object_r:sysfs_sensors:s0
genfscon sysfs /class/sensors/sensorhub_dump                               u:object_r:sysfs_sensors:s0

# Touchscreen Firmware/Status
genfscon sysfs /devices/platform/huawei_ts_kit/debug_info                  u:object_r:sysfs_touchscreen:s0

genfscon proc /log-usertype                                                u:object_r:proc_log_usertype:s0

genfscon sysfs /firmware/devicetree/base/hisi,product_name                 u:object_r:sysfs_hisi_product:s0

