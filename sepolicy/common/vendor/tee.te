allow tee teecd_device:chr_file { ioctl read write open };
allowxperm tee teecd_device:chr_file ioctl { 0x7401 0x7402 0x7403 0x7405 0x7406 0x7407 0x740e 0x7411 0x7412 0x7414 0x7415 };


allow hal_keymaster_default teecd_device:chr_file { ioctl read write };
allow hal_gatekeeper_default teecd_device:chr_file { ioctl read write };
allow hal_secure_element_default teecd_device:chr_file { ioctl read write };
allow hal_drm_widevine teecd_device:chr_file { ioctl read write map };
allow hal_fingerprint_default teecd_device:chr_file { ioctl read write map };

allow hal_libteec_default teecd_device:chr_file { map };

allow hal_keymaster_default tee:fd { use };
allow hal_gatekeeper_default tee:fd { use };
allow hal_secure_element_default tee:fd { use };
allow hal_fingerprint_default tee:fd { use };

allow hal_keymaster_default tee:unix_stream_socket { connectto };
allow hal_gatekeeper_default tee:unix_stream_socket { connectto };
allow hal_secure_element_default tee:unix_stream_socket { connectto };
allow hal_fingerprint_default tee:unix_stream_socket { connectto };

