cc_library_shared {
    name: "libshim_log",
    srcs: ["libshim_log.cpp"],
    shared_libs: ["liblog"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_hardware",
    srcs: ["libshim_hardware.cpp"],
    shared_libs: [
        "liblog",
        "libhardware"
    ],
    vendor: true,
}

cc_library_shared {
    name: "libshim_ui",
    srcs: ["libshim_ui.cpp"],
    shared_libs: [
        "libui",
        "libutils"
    ],
    vendor: true,
}

cc_library_shared {
    name: "libshim_emcom",
    shared_libs: [
        "libcutils_shim",
        "libtinyxml2_shim"
    ],
}

cc_library_shared {
    name: "guivnd",
    shared_libs: [
        "libgui_vendor",
        "libsensor_vendor"
    ],
    vendor: true,
}

cc_library_shared {
    name: "libshim_hwcam",
    shared_libs: [
        "libgui_vendor",
        "libui",
        "libshim_ui",
        "libui_shim",
        "libtinyxml2_shim"
    ],
    vendor: true,
}

cc_library_shared {
    name: "libshim_audioparams",
    srcs: ["libshim_audioparams.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
    ],
    vendor: true,
}

cc_library_shared {
    name: "liblogshim",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hwlog.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libshim_omx",
    srcs: ["libshim_omx.cpp"],
    shared_libs: [
        "libui",
        "libutils"
    ],
    vendor: true,
}
