filegroup {
    name: "android.hardware.audio-impl-hisi_srcs",
    srcs: [
        "Device.cpp",
        "DevicesFactory.cpp",
        "ParametersUtil.cpp",
        "PrimaryDevice.cpp",
        "Stream.cpp",
        "StreamIn.cpp",
        "StreamOut.cpp",
        "HisiRegister.cpp",
    ],
}

cc_library_headers {
    name: "android.hardware.audio-impl-hisi_headers",
    proprietary: true,
    vendor: true,
    export_include_dirs: ["include"],
}

cc_defaults {
    name: "android.hardware.audio-impl-hisi_default",
    relative_install_path: "hw",
    proprietary: true,
    vendor: true,
    srcs: [":android.hardware.audio-impl-hisi_srcs"],

    defaults: ["hidl_defaults"],

    static_libs: [
        "libaudiofoundation",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libmedia_helper",
        "libmediautils_vendor",
        "libmemunreachable",
        "libutils",
        "android.hardware.audio.common-util",
    ],

    header_libs: [
        "android.hardware.audio-impl-hisi_headers",
        "android.hardware.audio.common.util@all-versions",
        "libaudioutils_headers",
        "libaudio_system_headers",
        "libhardware_headers",
        "libmedia_headers",
        "libmediautils_headers",
    ],

    export_header_lib_headers: [
        "android.hardware.audio-impl-hisi_headers",
    ],

    cflags: select(soong_config_variable("android_hardware_audio", "skip_speaker_layout_channel_mask_field"), {
        true: ["-include common/all-versions/SkipSpeakerLayoutChannelMaskField.h"],
        default: [],
    }),
}

cc_defaults {
    name: "android.hardware.audio@6.0-impl-hisi_default",
    defaults: ["android.hardware.audio-impl-hisi_default"],
    shared_libs: [
        "android.hardware.audio@6.0",
        "android.hardware.audio@6.0-util",
        "android.hardware.audio.common@6.0",
        "android.hardware.audio.common@6.0-util",
    ],
    cflags: [
        "-DMAJOR_VERSION=6",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}

cc_library_shared {
    name: "android.hardware.audio@6.0-impl-hisi",
    defaults: ["android.hardware.audio@6.0-impl-hisi_default"],
}
